# Copy this file to .env and replace the placeholders with your own values.
# The app loads .env on startup (python-dotenv). .env is gitignored — never commit it.
#
#   cp .env.example .env

# Gmail address used as the From address for booking emails.
SENDER_EMAIL=your-sender@gmail.com

# Gmail app password for SENDER_EMAIL (Google Account > Security > App passwords).
# This is not your normal Gmail password.
SENDER_PASSWORD=your-gmail-app-password

# Hugging Face Hub token used for Llama 3.3 70B. Leave blank to skip live model calls.
HF_TOKEN=hf_your_token_here

# PostgreSQL connection URI. Leave unset to use local SQLite.
# Example:
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=

# Optional alias read on Render. Same URI shape as DATABASE_URL.
SUPABASE_URL=

# Local web server port. Defaults to 8501 when unset.
PORT=8501
